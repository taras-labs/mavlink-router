# This is the mavlink-router configuration file.

# Syntax
#
# The configuration file is composed of sections, each containing a set of
# key-value-pairs. Section names, keys and pre-defined values are case
# insensitive. Sections can have names when they have multiple instances.
#
# Lines starting with a `#` symbol are considered a comment and ignored.
# Comments at the end of a line are not allowed.
#
# A section starts with `[$section_type name-of-section]`. The name must not
# contain any blanks.
# Keys-value-pairs are separated by a `=` sign, the surrounding whitespace is
# ignored. So `key=value` is the same as `key = value`.
#
# Boolean values can either be defined as <true>/ <false> or <1>/ <0>.
# Lists are comma separated.
#

##
## General Configuration
##

[General]
# this section only has one instance and therefore no name

# Print traffic statistics to stdout
# Default: <false>
#ReportStats = false

# Logging verbosity (stderr)
# Valid values: <error>, <warning>, <info>, <debug> or <trace>
# Default: <info>
#DebugLogLevel = info

# Enable de-duplication of incoming messages. If a message is received another
# time in the configured time period (in milliseconds), it will be dropped. The
# second message will reset the timer.
# It should be a bit higher, than the latency of the slowest link. More than
# 1000 ms might drop packets unintentionally though.
# Default: 0 (de-duplication disabled)
#DeDuplicationPeriod = 0

## TCP Server Endpoints

# Listen for TCP connections on this port. Set to 0 to disable.
# Default: 5760
#TcpServerPort = 5760

## Flight Stack Logging

# Define the MAVLink dialect used by the flight stack, so mavlink-router can
# log appropiately. In <auto> mode, the flight stack will be deferred from the
# heartbeat message.
# Valid values: <auto>, <common> or <ardupilotmega>
# Default: <auto>
#MavlinkDialect = auto

# Enable flight stack logging and specify directory to save log files in.
# No default/ disabled by default.
#Log = /some/path

# Define when to store flight stack or telemetry logs. From the start of
# mavlink-router until it's stopped or just while the vehicle is armed.
# Valid values: <always>, <while-armed>
# Default: <always>
#LogMode = always

# Preset the FCU MAVLink ID from which logs should be received. If absent, it
# will be set to the system ID of the first flight stack heartbeat received.
# No default value.
#LogSystemId = 

# Auto-delete old log files until there's at least the configured amount of
# bytes free on the storage device. Set to 0 to disable this functionality.
# Default: 0 (disabled)
#MinFreeSpace = 0

# Auto-delete old log files to not have more files than configured. Set to 0 to
# disable this functionality.
# Default: 0 (disabled)
#MaxLogFiles = 0

# SnifferSysid
# Forward all traffic to endpoints on which this MAVLink system ID is connected.
# This can be used to log or view all messages flowing though mavlink-router.
# Default: 0 (disabled)
#SnifferSysid=254

# Log raw mavlink telemetry data as tlog files to disc. Only works if Logging path 
# is defined. This also uses LogMode to control the recording.
# Valid values: <true>, <false>
# Default: <false>
# LogTelemetry = false

# CompPriority
# Let one component at a time drive a vehicle with the messages in
# CompPriorityMsgIds, e.g. two RC transmitters both sending
# RC_CHANNELS_OVERRIDE, which the autopilot would otherwise interleave. The
# first listed component that sent one within CompPriorityTimeout wins; a
# higher one takes over on its first message, a lower one only after the
# higher has been silent for the whole timeout. Components not listed pass
# untouched. Arbitrated separately per target system.
# Default: empty (disabled)
#CompPriority = 190,191

# CompPriorityMsgIds
# Default: 70,69 (RC_CHANNELS_OVERRIDE, MANUAL_CONTROL)
#CompPriorityMsgIds = 70,69

# CompPriorityTimeout
# Milliseconds of silence after which a component loses its turn.
# Default: 500
#CompPriorityTimeout = 500

# RcControlPort
# UDP port on which a controller sets the RC gate's mode, one datagram of text
# per mode, re-sent as often as it likes; the last one holds until the next:
#   open   no remote pilot: RC_CHANNELS_OVERRIDE / MANUAL_CONTROL pass from all
#   pilot  only from RcPilotEndpoint and RcPassCompids; the router sends
#          RcFailsafe itself while the pilot is silent for RcFailsafeTimeout
#   local  the station took over from the pilot: only from RcLocalEndpoint
#          and RcPassCompids (with no RcLocalEndpoint, from all but the pilot)
# Leaving pilot mode sends one frame handing back to the RC radio the channels
# the pilot's (or the failsafe) frame held. The router starts open. Keep the
# port off any network a stranger can reach: it has no authentication.
# Default: 0 (no RC gate)
#RcControlPort = 14570

# RcPilotEndpoint
# The endpoint (by name) the remote pilot's transmitter sends on. Whatever
# arrives there is the pilot's, whichever component id it carries: a compid
# is whatever the sender writes, so it names a source and identifies nothing.
# In pilot mode only from the address the controller names with the mode.
# Required with RcControlPort.
#RcPilotEndpoint = out2

# RcPilotSysid
# RC_CHANNELS_OVERRIDE / MANUAL_CONTROL arriving on RcPilotEndpoint is passed
# on as this source sysid, its checksum rewritten to match (a signed frame is
# passed on as it is). A transitional measure: pilots up to 3.6.12 send their
# RC as sysid 254, which the FC drops (it takes overrides from SYSID_MYGCS
# only); from 3.7.0 they send 255 themselves.
# TODO(pilot-sysid): remove once every pilot runs v3.7.0+.
# Default: 0 (as sent)
#RcPilotSysid = 255

# RcLocalEndpoint
# The endpoint this station's own transmitter sends on, likewise by port
# alone: the one RC source local mode lets through besides RcPassCompids.
# Default: none (local mode passes everything but RcPilotEndpoint)
#RcLocalEndpoint = out3

# RcPriorityEndpoint
# The endpoint RcPriorityCompid's frames must arrive on to hold the sticks;
# from anywhere else that compid is an ordinary source. A frame on
# RcPilotEndpoint or RcLocalEndpoint is that transmitter's whatever its compid.
# The three must differ.
# Default: none (any endpoint)
#RcPriorityEndpoint = out1

# RcPassCompids
# Components whose RC passes in every mode, e.g. a frame driving only the
# channels the pilot leaves alone.
# Default: empty
#RcPassCompids = 194

# RcFailsafeTimeout
# Milliseconds of pilot silence in pilot mode before the failsafe frame. 0
# never sends it. Needs a Master endpoint.
# Default: 500
#RcFailsafeTimeout = 500

# RcFailsafe
# The failsafe frame, sent as GcsSysid/GcsCompid to every autopilot on a Master
# endpoint: up to 18 comma-separated entries, channel 1 first, each a pulse
# width, "last" (the pilot's last value, "ignore" before the first) or
# "ignore" (65535, the channel stays as it is). Channels not listed are
# "last". Overriding every channel keeps the FC's own receiver out; the
# throttle must sit below the FC's FS_THR_VALUE / THR_FS_VALUE for the FC to
# hold its RC failsafe.
# Default: 1500,1500,900,1500
#RcFailsafe = 1500,1500,900,1500

# RcFailsafeRate
# Hz the failsafe frame is sent at.
# Default: 10
#RcFailsafeRate = 10

# RcPriorityCompid
# A component above the gate's modes: while it holds the sticks (it sent a
# frame with a value in it within RcPriorityTimeout) it passes in every mode
# and every other RC source but RcPassCompids is dropped, the pilot's included.
# A frame of it that holds nothing ends the hold at once. In pilot mode it
# counts as the pilot flying, so no failsafe frame is sent while it drives.
# Default: none
#RcPriorityCompid = 0

# RcPriorityTimeout
# Milliseconds one of its frames holds the sticks for.
# Default: 1500
#RcPriorityTimeout = 1500

# RcPassTimeout
# RcPassCompids pass only while some stick source passed within this many
# milliseconds (the router's own failsafe frame does not count): any RC frame tells the
# FC its radio is alive, so a frame re-sent for a couple of channels alone would
# keep it from ever noticing the transmitter gone. They pass anyway until the
# first stick source. 0 lets them pass always.
# Default: 0
#RcPassTimeout = 1500

# GcsHeartbeatRate
# Send a GCS HEARTBEAT (as GcsSysid/GcsCompid) to every Master endpoint at this
# rate, like MAVProxy does. Needs a Master endpoint.
# Default: 0 (disabled)
#GcsHeartbeatRate = 1

# StreamRate
# Ask every autopilot seen on a Master endpoint for MAV_DATA_STREAM_ALL at this
# rate, on first sight and every 15 s after, like MAVProxy's streamrate. Needs a
# Master endpoint.
# Default: 0 (disabled)
#StreamRate = 4

# DisableMessages
# Keep these messages off on every autopilot seen on a Master endpoint: when
# one of them is heard from it, the router sends MAV_CMD_SET_MESSAGE_INTERVAL -1
# for it back on that link, because the autopilot forgets it on reboot and on
# any REQUEST_DATA_STREAM (StreamRate's included). Nothing is sent while they
# stay off; at most one command a second per link, and one per message per 3 s
# while copies sent before the autopilot obeyed are still arriving. Message ids,
# comma separated; HEARTBEAT (0) is refused. Needs a Master endpoint.
# Default: empty (disabled)
#DisableMessages = 87,62,11039

# GcsSysid / GcsCompid
# Source of the messages above.
# Default: 255 / 230 (MAVProxy's)
#GcsSysid = 255
#GcsCompid = 230

# MasterFailoverTimeout
# With two or more Master endpoints carrying the same vehicle (two links to
# one autopilot), pass each vehicle's (source sysid's) messages from one
# master only: the best MasterPriority one that delivered within this many
# milliseconds. A better one takes over on its first message. Messages from
# the GCS side to a vehicle go out on that vehicle's current master only, ones
# with no target on the current master of every autopilot; with nothing heard
# within the timeout they go to every master. GcsHeartbeatRate and StreamRate
# keep going to every master, so a standby link keeps streaming.
# Default: 0 (disabled: every master passes)
#MasterFailoverTimeout = 500


##
## UART Endpoint Configurations
## Duplicate sections (with a different name) to create multiple endpoints
##

#[UartEndpoint $name]

# Path to UART device. like `/dev/ttyS0`
# Mandatory, no default value
#Device = 

# List of baudrates to use for the UART connection. The values will be cycled
# through until valid MAVLink packets are received.
# Format: Comma separated list of integers
# Default: 115200
#Baud = 115200

# Enable flow control on device
# Default: <false>
#FlowControl = false

# Only allow specified MAVLink message IDs to be sent via this endpoint. An
# empty list allows all message IDs.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#AllowMsgIdOut = 

# Block specified MAVLink message IDs to be sent via this endpoint. An
# empty list won't block any message IDs.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#BlockMsgIdOut = 

# Only allow messages from the specified MAVLink source component IDs to be
# sent via this endpoint. An empty list allows all source components.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#AllowSrcCompOut = 

# Block messages from the specified MAVLink source component IDs to be
# sent via this endpoint. An empty list won't block any source components.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#BlockSrcCompOut = 

# Only allow messages from the specified MAVLink source systems to be sent via
# this endpoint. An empty list allows all source components.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#AllowSrcSysOut = 

# Block messages from the specified MAVLink source systems to be sent via
# this endpoint. An empty list won't block any source systems.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#BlockSrcSysOut = 

# Rate limit for messages sent via this endpoint (UART, UDP and TCP endpoints
# alike), message id and the most Hz it may leave at. A message that arrives
# when its interval since the last one sent is over is sent at once; one that
# arrives sooner is held until the interval is over, and a fresher one arriving
# meanwhile replaces it, so what is sent is always the latest value. Counted per
# message id and per sender (sysid/compid). Nothing else is slowed down: the
# other endpoints still get every message. Hz may be fractional, 0 is refused
# (BlockMsgIdOut stops a message).
# Format: Comma separated list of <message id>:<Hz>
# Default: Empty list (disabled)
#MsgRateOut = 30:10,33:2

# Only allow specified MAVLink message IDs to be received on this endpoint.
# An empty list allows all message IDs.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#AllowMsgIdIn = 

# Block specified MAVLink message IDs to be received on this endpoint.
# An empty list won't block any message IDs.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#BlockMsgIdIn = 

# Only allow messages from the specified MAVLink source component IDs to be
# received on this endpoint. An empty list allows all source components.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#AllowSrcCompIn = 

# Block messages from the specified MAVLink source component IDs to be
# received on this endpoint. An empty list won't block any source components.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#BlockSrcCompIn = 

# Only allow messages from the specified MAVLink source systems to be received
# on this endpoint. An empty list allows all source components.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#AllowSrcSysIn = 

# Block messages from the specified MAVLink source systems to be received
# on this endpoint. An empty list won't block any source systems.
# Format: Comma separated list of integers
# Default: Empty list (disabled)
#BlockSrcSysIn = 

# Group parallel/ redundant data links to use the same list of connected
# systems. This is needed to prevent messages from one of the parallel links
# being send back on the other one right away.
# Set the same name (arbitrary string) on multiple endpoints to group them.
# Default: Empty (no group)
#Group = 

# Master (UART, UDP and TCP endpoints)
# MAVProxy-style routing. Once any endpoint is a Master, everything a master
# receives goes to every non-master endpoint whatever it is addressed to,
# everything else goes to the masters only (routed by target as usual), and
# nothing passes between two masters or between two non-masters. TCP server
# clients are non-masters.
# Default: false
#Master = false

# MasterPriority (UART, UDP and TCP endpoints)
# Order of the Master endpoints for MasterFailoverTimeout, lower first. Ties
# keep the order endpoints are created in: UART, then UDP, then TCP sections.
# Default: 0
#MasterPriority = 0

## Example
[UartEndpoint alpha]
Device = /dev/ttyS0
Baud = 52000


##
## UDP Endpoint Configurations
## Duplicate sections (with a different name) to create multiple endpoints
##

#[UdpEndpoint $name]

# Mode of operation. See the readme for a detailed description of the endpoint
# behavior (client mode is <normal> in the configuraiton).
# Valid values: <normal>, <server>
# Mandatory, no default value
#Mode = 

# Binding or target IP address (depending on mode).
# IPv6 addresses must be encosed in square brackets like `[::1]`.
# Binding to `0.0.0.0` or `[::]` will listen on all interfaces.
# Mandatory, no default value
#Address = 

# UDP port to be used with the configured address.
# Mandatory in <server> mode, no default value
# Optional in <normal> mode, will select the next port not used by mavlink-router
#   starting from 14550 when not speciifed.
#Port = 

# See description at UartEndpoint
#AllowMsgIdOut = 

## Examples
# bind to 0.0.0.0:10000
[UdpEndpoint bravo]
Mode = Server
Address = 0.0.0.0
Port = 10000

# send to 127.0.0.1:11000
[UdpEndpoint charlie]
Mode = Normal
Address = 127.0.0.1
Port = 11000


##
## TCP Client Endpoint Configurations
## Duplicate sections (with a different name) to create multiple endpoints
##

#[TcpEndpoint $name]

# Server IP address to connect to.
# IPv6 addresses must be encosed in square brackets like `[::1]`.
# Mandatory, no default value
#Address = 

# TCP port to be used with the configured address.
# Mandatory, no default value
#Port = 

# Enable automatic reconnect after the configured timeout in seconds. Set to 0
# to disable reconnection.
# Default: 5 seconds
#RetryTimeout = 5

# See description at UartEndpoint
#AllowMsgIdOut = 

## Example
# connect to 127.0.0.1:25760 (e.g. another mavlink-router)
[TcpEndpoint delta]
Address = 127.0.0.1
Port = 25760
